{$DOMAIN_NAME:localhost} {
    # If the frontend requests /api or /auth, proxy to FastAPI
    handle /api/* {
        reverse_proxy api:8000
    }
    handle /docs* {
        reverse_proxy api:8000
    }
    handle /openapi.json {
        reverse_proxy api:8000
    }
    # Route everything else to React (frontend)
    handle {
        reverse_proxy frontend:3000
    }
}

# Separate subdomain directly for the API (useful if the frontend expects a full URL)
api.dalibude.duckdns.org {
    reverse_proxy api:8000
}
